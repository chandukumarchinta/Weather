							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Contains weather and main metrics', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('main');",
